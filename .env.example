APP_NAME="PCLAP Finanzas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base propia de Finanzas: series, comprobantes electrónicos y sus líneas
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dbfinanzas
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Base de prueba de PCLAP: SOLO LECTURA (crear un usuario MySQL con GRANT SELECT únicamente)
PCLAP_DB_DRIVER=mysql
PCLAP_DB_HOST=127.0.0.1
PCLAP_DB_PORT=3306
PCLAP_DB_DATABASE=dbsistemapclap
PCLAP_DB_USERNAME=pclap_lector
PCLAP_DB_PASSWORD=

# SUNAT: modo beta (pruebas gratuitas). Credenciales públicas de prueba.
SUNAT_MODO=beta
SUNAT_RUC=20000000001
SUNAT_USUARIO_SOL=MODDATOS
SUNAT_CLAVE_SOL=moddatos
SUNAT_CERTIFICADO=app/sunat/certificado.pem
SUNAT_RAZON_SOCIAL="PCLAP SUPPORT"
SUNAT_NOMBRE_COMERCIAL="PCLAP SUPPORT"
SUNAT_DIRECCION=
SUNAT_UBIGEO=150101
SUNAT_DEPARTAMENTO=LIMA
SUNAT_PROVINCIA=LIMA
SUNAT_DISTRITO=LIMA

# Usuario administrador que crea el seeder (php artisan db:seed)
FINANZAS_ADMIN_EMAIL=admin@pclap.test
FINANZAS_ADMIN_PASSWORD=123456
